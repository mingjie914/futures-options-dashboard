SEAT_SOURCE_BACKEND=parquet
# The serving and publishing store is DuckDB; unsupported values fail closed.
DASHBOARD_READ_STORE=duckdb
DASHBOARD_PUBLISH_STORES=duckdb

# Build-time inputs only. Configure actual mounted dataset directories on the builder.
# Relative paths below resolve against the project root, not the shell working directory.
SEAT_LOCAL_ROOT=data/futuresseatdata
MARKET_1D_LOCAL_ROOT=data/futureshistoryprices1d
SEAT_TAG_CONFIG=config/seat-tags.csv
SEAT_COMBINATION_CONFIG=config/combinations.json
SEAT_PRODUCT_CONFIG=config/products.csv
# Runtime API needs only an already-published snapshot and manifest.
DASHBOARD_RUNTIME_ROOT=var
DASHBOARD_API_HOST=127.0.0.1
DASHBOARD_API_PORT=8000
# Per API process; keep one process unless a separate server budget is agreed.
DASHBOARD_DUCKDB_THREADS=1
DASHBOARD_DUCKDB_MEMORY_MB=256
DASHBOARD_QUERY_CONCURRENCY=1
DASHBOARD_CACHE_BYTES=134217728

# Empty uses /api/seats/v1; local Vite proxies requests to the backend.
NEXT_PUBLIC_API_BASE_URL=
DASHBOARD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
