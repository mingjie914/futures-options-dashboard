{
  "name": "research-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "python -X utf8 tools/build_frontend.py && vite build",
    "build:refresh-futures": "python -X utf8 tools/build_frontend.py --refresh-futures && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.mjs tools/check_transport.mjs ../futures/frontend/tests/lineSegments.test.mjs ../futures/frontend/tests/market-panels.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "echarts": "6.1.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "vite": "8.0.13"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "22.19.19"
  }
}
